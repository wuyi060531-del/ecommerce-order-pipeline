# 配置模板；应用只读取已导出的环境变量，不自动加载此文件。
# 先创建一个仅供本项目使用的数据库，不要连接其他项目的数据库。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=order_pipeline
MYSQL_PASSWORD=replace_with_your_local_password
MYSQL_DATABASE=order_pipeline
MYSQL_CONNECT_TIMEOUT=10
# 可选：仅使用可信 CA 时启用；远程连接推荐配置。
# MYSQL_SSL_CA=/absolute/path/to/ca.pem
# 实机集成测试须显式启用、使用空库且库名以 _test 或 _smoke 结尾：
# MYSQL_DATABASE=order_pipeline_test
# MYSQL_INTEGRATION=1
